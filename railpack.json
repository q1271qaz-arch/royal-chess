{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.12"
  },
  "deploy": {
    "aptPackages": [
      "...",
      "stockfish"
    ],
    "startCommand": "gunicorn --worker-class eventlet -w 1 app:app",
    "variables": {
      "LANG": "en_US.UTF-8",
      "TZ": "UTC"
    }
  }
}